---
import type { CollectionEntry } from 'astro:content';

interface Props {
  poem: CollectionEntry<'poems'>;
  author: CollectionEntry<'authors'> | undefined;
}

const { poem, author } = Astro.props;
---

<p class="byline">
  {
    author ? (
      <a href={`/authors/${author.id}/`}>{author.data.name}</a>
    ) : (
      'Unknown'
    )
  }
  {poem.data.year && <> · {poem.data.year}</>}
  {poem.data.translator && <> · translated by {poem.data.translator}</>}
</p>
