---
/**
 * The quiet sound corner: ambience picker, typing/page-turn effects toggle,
 * and read-aloud controls (shown only on poem pages). Everything is opt-in
 * and remembered in localStorage.
 */
---

<details class="sound-dock" id="sound-dock">
  <summary><span aria-hidden="true">♪</span> sound</summary>
  <div class="dock-body">
    <label>
      ambience
      <select id="amb-select">
        <option value="off">off</option>
        <option value="birds">birdsong</option>
        <option value="stream">stream</option>
        <option value="rain">rain</option>
        <option value="crickets">night crickets</option>
      </select>
    </label>
    <label>
      <input type="checkbox" id="fx-toggle" />
      typing &amp; page sounds
    </label>
    <label>
      volume
      <input type="range" id="vol-slider" min="0" max="1" step="0.05" />
    </label>
    <div id="narration-controls" hidden>
      <label>
        voice
        <select id="voice-select"></select>
      </label>
      <button type="button" id="narrate-btn">read this poem aloud</button>
    </div>
  </div>
</details>

<script>
  import {
    ensureAudio,
    audioRunning,
    typeClick,
    pageTurn,
    setAmbience,
    setMasterVolume,
  } from '../lib/audio';
  import {
    classify,
    scoreVoice,
    voicesReady,
    speak,
    stopNarration,
    narrating,
  } from '../lib/narration';

  type Amb = 'off' | 'birds' | 'stream' | 'rain' | 'crickets';
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const state = {
    get ambience(): Amb {
      return (localStorage.getItem('ww:ambience') as Amb) ?? 'off';
    },
    set ambience(v: Amb) {
      localStorage.setItem('ww:ambience', v);
    },
    get fx(): boolean {
      return localStorage.getItem('ww:fx') === 'on';
    },
    set fx(v: boolean) {
      localStorage.setItem('ww:fx', v ? 'on' : 'off');
    },
    get voice(): string | null {
      return localStorage.getItem('ww:voice');
    },
    set voice(v: string | null) {
      if (v) localStorage.setItem('ww:voice', v);
    },
    get volume(): number {
      const v = parseFloat(localStorage.getItem('ww:volume') ?? '');
      return Number.isFinite(v) ? v : 0.6;
    },
    set volume(v: number) {
      localStorage.setItem('ww:volume', String(v));
    },
  };

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  function populateVoices(select: HTMLSelectElement): void {
    voicesReady((voices) => {
      if (!voices.length) {
        select.closest('#narration-controls')?.setAttribute('hidden', '');
        return;
      }
      const groups: Record<string, SpeechSynthesisVoice[]> = {
        female: [],
        male: [],
        other: [],
      };
      for (const v of voices) groups[classify(v)].push(v);
      // Best voices first — platforms bury their natural/neural ones.
      for (const g of Object.values(groups)) {
        g.sort((a, b) => scoreVoice(b) - scoreVoice(a));
      }
      select.innerHTML = '';
      for (const name of ['female', 'male', 'other'] as const) {
        if (!groups[name].length) continue;
        const og = document.createElement('optgroup');
        og.label = `${name} voices`;
        for (const v of groups[name]) {
          const opt = document.createElement('option');
          opt.value = v.voiceURI;
          opt.textContent =
            v.name.replace(/\s*\(.*\)$/, '') + (scoreVoice(v) >= 4 ? ' ✦' : '');
          og.append(opt);
        }
        select.append(og);
      }
      const saved = state.voice;
      if (saved && voices.some((v) => v.voiceURI === saved)) {
        select.value = saved;
      } else if (groups.female[0]) {
        select.value = groups.female[0].voiceURI;
      }
    });
  }

  /**
   * Stanza texts come from the rendered <p> elements, so highlight indexes
   * align with the DOM by construction. Entries 0–1 are title and byline.
   */
  function poemStanzas(): { texts: string[]; paragraphs: HTMLElement[] } {
    // After the typewriter runs, the h1 holds the title twice (the
    // visually-hidden copy plus the animated one) — read it only once.
    const h1 = document.querySelector('main h1');
    const title =
      (h1?.querySelector('.visually-hidden') ?? h1)?.textContent?.trim() ?? '';
    const byline =
      document.querySelector('.byline')?.textContent?.split('·')[0]?.trim() ?? '';
    const paragraphs = [
      ...document.querySelectorAll<HTMLElement>('.poem-body p'),
    ];
    return {
      texts: [title, byline && `by ${byline}`, ...paragraphs.map((p) => p.innerText)],
      paragraphs,
    };
  }

  function clearHighlight(): void {
    const body = document.querySelector('.poem-body');
    body?.classList.remove('narrating');
    body?.querySelectorAll('.now').forEach((p) => p.classList.remove('now'));
  }

  function initDock(): void {
    const amb = $<HTMLSelectElement>('amb-select');
    const fx = $<HTMLInputElement>('fx-toggle');
    const vol = $<HTMLInputElement>('vol-slider');
    const voiceSelect = $<HTMLSelectElement>('voice-select');
    const narrateBtn = $<HTMLButtonElement>('narrate-btn');
    const narration = $('narration-controls');
    if (!amb || !fx || !vol || !voiceSelect || !narrateBtn || !narration) return;

    amb.value = state.ambience;
    fx.checked = state.fx;
    vol.value = String(state.volume);
    setMasterVolume(state.volume);
    vol.oninput = () => {
      state.volume = parseFloat(vol.value);
      ensureAudio();
      setMasterVolume(state.volume);
    };

    amb.onchange = () => {
      state.ambience = amb.value as Amb;
      setAmbience(state.ambience);
    };
    fx.onchange = () => {
      state.fx = fx.checked;
      if (fx.checked) {
        ensureAudio();
        typeClick();
      }
    };

    if (document.querySelector('.poem-body')) {
      narration.hidden = false;
      populateVoices(voiceSelect);
      voiceSelect.onchange = () => {
        state.voice = voiceSelect.value;
      };
      narrateBtn.onclick = () => {
        if (narrating()) {
          stopNarration();
          clearHighlight();
          narrateBtn.textContent = 'read this poem aloud';
          return;
        }
        narrateBtn.textContent = 'stop reading';
        const { texts, paragraphs } = poemStanzas();
        document.querySelector('.poem-body')?.classList.add('narrating');
        speak(
          texts,
          voiceSelect.value || state.voice,
          () => {
            clearHighlight();
            narrateBtn.textContent = 'read this poem aloud';
          },
          (index) => {
            paragraphs.forEach((p, i) =>
              p.classList.toggle('now', i === index - 2)
            );
          }
        );
      };
    } else {
      narration.hidden = true;
    }
  }

  /**
   * Typewriter reveal on the page title. Screen readers get the full title
   * immediately (visually-hidden copy); the animated copy is aria-hidden.
   * Key clicks only once sound has been unlocked by a user gesture.
   */
  function typewriter(): void {
    if (reducedMotion) return;
    const h1 = document.querySelector<HTMLElement>('main h1');
    if (!h1 || h1.dataset.tw) return;
    h1.dataset.tw = 'done';
    const text = h1.textContent ?? '';
    h1.textContent = '';
    const sr = document.createElement('span');
    sr.className = 'visually-hidden';
    sr.textContent = text;
    const anim = document.createElement('span');
    anim.className = 'tw-text';
    anim.setAttribute('aria-hidden', 'true');
    h1.append(sr, anim);
    let i = 0;
    const step = () => {
      if (!anim.isConnected) return;
      anim.textContent = text.slice(0, ++i);
      if (state.fx && text[i - 1] !== ' ') typeClick();
      if (i < text.length) {
        setTimeout(step, 45 + Math.random() * 55);
      } else {
        anim.classList.add('tw-done');
      }
    };
    setTimeout(step, 250);
  }

  /** Poem pages can suggest a matching ambience; starting it is one click. */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.ambience-suggest');
    if (!btn) return;
    const kind = (btn.dataset.ambience ?? 'off') as Amb;
    state.ambience = kind;
    setAmbience(kind);
    const amb = $<HTMLSelectElement>('amb-select');
    if (amb) amb.value = kind;
    btn.blur();
  });

  /** Arrow keys turn the page (outside form fields, no modifiers). */
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, select, textarea, button, [contenteditable]')) return;
    if (e.key === 'ArrowLeft') {
      document.querySelector<HTMLAnchorElement>('.poem-nav a[rel="prev"]')?.click();
    } else if (e.key === 'ArrowRight') {
      document.querySelector<HTMLAnchorElement>('.poem-nav a[rel="next"]')?.click();
    }
  });

  /** Header theme toggle: system default until first click, then persisted. */
  function initThemeToggle(): void {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const current = () =>
      document.documentElement.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const paint = () => {
      const dark = current() === 'dark';
      btn.textContent = dark ? '☀' : '☾';
      btn.setAttribute(
        'aria-label',
        dark ? 'switch to light theme' : 'switch to dark theme'
      );
    };
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('ww:theme', next);
      paint();
    });
    paint();
  }

  document.addEventListener('astro:page-load', () => {
    initDock();
    initThemeToggle();
    typewriter();
  });

  document.addEventListener('astro:before-swap', () => {
    stopNarration();
    clearHighlight();
  });

  document.addEventListener('astro:after-swap', () => {
    // The swap installs a fresh <html>; restore the chosen theme first.
    const theme = localStorage.getItem('ww:theme');
    if (theme) document.documentElement.dataset.theme = theme;
    if (state.fx && audioRunning()) pageTurn();
  });
</script>
