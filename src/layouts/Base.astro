---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SoundDock from '../components/SoundDock.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A quiet place to read poems.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Withering Words</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Withering Words" href="/rss.xml" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">withering words</a>
      <nav aria-label="site">
        <a href="/">poems</a>
        <a href="/moods/">moods</a>
        <a href="/search/">search</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer style="text-align: center; color: var(--ink-soft); font-size: 0.85rem; padding-block: 2rem;">
      <p>read slowly.</p>
    </footer>
    <SoundDock />
  </body>
</html>
