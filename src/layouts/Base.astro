---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '../styles/global.css';
import SoundDock from '../components/SoundDock.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'A quiet place to read poems.', ogImage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Withering Words" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} · Withering Words</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Withering Words" href="/rss.xml" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">withering words</a>
      <nav aria-label="site">
        <a href="/">poems</a>
        <a href="/moods/">moods</a>
        <a href="/wander/">wander</a>
        <a href="/search/">search</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer style="text-align: center; color: var(--ink-soft); font-size: 0.85rem; padding-block: 2rem;">
      <p>read slowly. · <a href="/about/" style="color: inherit;">about</a></p>
    </footer>
    <SoundDock />
  </body>
</html>
