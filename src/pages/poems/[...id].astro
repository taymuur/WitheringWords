---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PoemMeta from '../../components/PoemMeta.astro';
import PoemNav from '../../components/PoemNav.astro';

export async function getStaticPaths() {
  const poems = (await getCollection('poems')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  const link = (p: (typeof poems)[number] | undefined) =>
    p ? { id: p.id, title: p.data.title } : null;
  return poems.map((poem, i) => ({
    params: { id: poem.id },
    props: { poem, prev: link(poems[i - 1]), next: link(poems[i + 1]) },
  }));
}

const { poem, prev, next } = Astro.props;
const author = await getEntry(poem.data.author);
const { Content } = await render(poem);
---

<Base title={poem.data.title}>
  <article data-pagefind-body>
    <h1>{poem.data.title}</h1>
    <PoemMeta poem={poem} author={author} />
    <div class="poem-body">
      <Content />
    </div>
    {
      poem.data.rights === 'excerpt' && (
        <p class="byline">
          An excerpt. <a href={poem.data.findTheBook}>Find the book</a>
          {poem.data.source && <> — <cite>{poem.data.source}</cite></>}.
        </p>
      )
    }
  </article>
  <PoemNav prev={prev} next={next} />
</Base>
