---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PoemMeta from '../../components/PoemMeta.astro';
import PoemNav from '../../components/PoemNav.astro';

export async function getStaticPaths() {
  const poems = (await getCollection('poems')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  const link = (p: (typeof poems)[number] | undefined) =>
    p ? { id: p.id, title: p.data.title } : null;
  return poems.map((poem, i) => ({
    params: { id: poem.id },
    props: { poem, prev: link(poems[i - 1]), next: link(poems[i + 1]) },
  }));
}

const { poem, prev, next } = Astro.props;
const author = await getEntry(poem.data.author);
const { Content } = await render(poem);

const firstLine = poem.body.trim().split('\n')[0];
const description = `${firstLine} — ${author?.data.name ?? 'Unknown'}${poem.data.year ? `, ${poem.data.year}` : ''}`;

// A poem's moods can suggest a matching ambience (started only by click).
const AMBIENCE_FOR_MOOD: Record<string, { kind: string; label: string }> = {
  rain: { kind: 'rain', label: 'let it rain while you read' },
  storm: { kind: 'rain', label: 'let it rain while you read' },
  sea: { kind: 'stream', label: 'let water run while you read' },
  water: { kind: 'stream', label: 'let water run while you read' },
  spring: { kind: 'birds', label: 'let birds sing while you read' },
  pastoral: { kind: 'birds', label: 'let birds sing while you read' },
  morning: { kind: 'birds', label: 'let birds sing while you read' },
  nature: { kind: 'birds', label: 'let birds sing while you read' },
  birds: { kind: 'birds', label: 'let birds sing while you read' },
  garden: { kind: 'birds', label: 'let birds sing while you read' },
  night: { kind: 'crickets', label: 'let crickets sing while you read' },
  evening: { kind: 'crickets', label: 'let crickets sing while you read' },
};
const suggestion = poem.data.moods
  .map((m) => AMBIENCE_FOR_MOOD[m])
  .find(Boolean);
---

<Base title={poem.data.title} description={description} ogImage={`/og/${poem.id}.png`}>
  <article data-pagefind-body>
    <h1>{poem.data.title}</h1>
    <PoemMeta poem={poem} author={author} />
    <div class="poem-body">
      <Content />
    </div>
    {
      poem.data.rights === 'excerpt' && (
        <p class="byline">
          This poem continues in <cite>{poem.data.source}</cite> —{' '}
          <a href={poem.data.findTheBook}>find the book</a>.
        </p>
      )
    }
    {
      suggestion && (
        <p class="mood-line" data-pagefind-ignore>
          <button type="button" class="ambience-suggest" data-ambience={suggestion.kind}>
            ♪ {suggestion.label}
          </button>
        </p>
      )
    }
    {
      poem.data.moods.length > 0 && (
        <p class="byline mood-line">
          {poem.data.moods.map((mood, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/moods/${mood}/`} data-pagefind-filter="mood">
                {mood}
              </a>
            </>
          ))}
        </p>
      )
    }
  </article>
  <PoemNav prev={prev} next={next} />
</Base>
