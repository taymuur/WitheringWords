{
  // Static-assets-only Worker: `npm run build` produces dist/, wrangler
  // uploads it. No server code runs — do NOT add an SSR adapter; the OG
  // cards and Pagefind index are generated at build time in Node.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witheringwords",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
